// SJJ-COM-Tool Windows 版本资源（由 CMake configure_file 注入版本号）
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
 PRODUCTVERSION  @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
 FILEFLAGS       0x1L
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "SJJ"
            VALUE "FileDescription",  "SJJ-COM-Tool - Windows Serial Port Debugger"
            VALUE "FileVersion",      "@APP_VERSION@"
            VALUE "InternalName",     "SJJ-COM-Tool"
            VALUE "LegalCopyright",   "Copyright (C) 2026 SJJ"
            VALUE "OriginalFilename", "SJJ-COM-Tool.exe"
            VALUE "ProductName",      "SJJ-COM-Tool"
            VALUE "ProductVersion",   "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
